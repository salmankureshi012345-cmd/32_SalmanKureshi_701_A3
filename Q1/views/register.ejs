<!DOCTYPE html>
<html>

<head>
    <title>Registration Form</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>User Registration Form</h1>

    <% if (errors.length > 0) { %>

        <div class="error">

            <% errors.forEach(function(error) { %>

                <p><%= error.msg %></p>

            <% }) %>

        </div>

    <% } %>


    <form action="/register" method="POST" enctype="multipart/form-data">

        <label>Username:</label>
        <input
            type="text"
            name="username"
            value="<%= oldData.username || '' %>"
        >

        <br><br>


        <label>Password:</label>
        <input
            type="password"
            name="password"
        >

        <br><br>


        <label>Confirm Password:</label>
        <input
            type="password"
            name="confirmPassword"
        >

        <br><br>


        <label>Email:</label>
        <input
            type="text"
            name="email"
            value="<%= oldData.email || '' %>"
        >

        <br><br>


        <label>Gender:</label>

        <input
            type="radio"
            name="gender"
            value="Male"
            <% if (oldData.gender == "Male") { %>
                checked
            <% } %>
        >

        Male

        <input
            type="radio"
            name="gender"
            value="Female"
            <% if (oldData.gender == "Female") { %>
                checked
            <% } %>
        >

        Female

        <br><br>


        <label>Hobbies:</label>

        <input
            type="checkbox"
            name="hobbies"
            value="Reading"
            <% if (oldHobbies.includes("Reading")) { %>
                checked
            <% } %>
        >

        Reading

        <input
            type="checkbox"
            name="hobbies"
            value="Sports"
            <% if (oldHobbies.includes("Sports")) { %>
                checked
            <% } %>
        >

        Sports

        <input
            type="checkbox"
            name="hobbies"
            value="Music"
            <% if (oldHobbies.includes("Music")) { %>
                checked
            <% } %>
        >

        Music

        <br><br>


        <label>Profile Picture:</label>

        <input
            type="file"
            name="profilePic"
        >

        <br><br>


        <label>Other Pictures:</label>

        <input
            type="file"
            name="otherPics"
            multiple
        >

        <br><br>


        <button type="submit">
            Register
        </button>

    </form>

</body>

</html>